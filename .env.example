# Copia questo file in .env e riempi i valori.
# .env non entra MAI nel repository.
#
# Regola: ogni variabile nuova va aggiunta qui, con valore fittizio e una
# riga di commento, nello stesso commit che la introduce.

# --- Ambiente ---
ENV=development
LOG_LEVEL=info

# --- Route engine ---
# Cartella dove tenere i grafi stradali scaricati (esclusa da git)
OSM_CACHE_DIR=./data/cache

# Le mappe non hanno chiavi: gli indirizzi dei servizi sono costanti nel
# codice dell'app (ADR-0029).

# --- Foto della mappa «Satellite» (TASK-264, ADR-0232) ---
# App: chiave di un account gratuito ArcGIS Location Platform (Esri). Con
# la chiave le foto passano dall'indirizzo di Esri per le chiavi, in regola
# per un'app con pubblicità; vuota, dall'indirizzo pubblico. Va in
# apps/mobile/.env e nelle variabili di EAS, non sull'API.
EXPO_PUBLIC_ARCGIS_API_KEY=

# --- Ricerca del luogo (TASK-123, ADR-0095, docs/DEPLOY.md) ---
# API: chiave di Geoapify (account gratuito su geoapify.com). Con la chiave
# l'API suggerisce i luoghi da GET /places; vuota, l'app usa Photon come
# prima. Resta sull'API: non va in apps/mobile/.env.
GEOAPIFY_API_KEY=

# --- Send to Strava (TASK-187, ADR-0156, docs/DEPLOY.md «Strava») ---
# API: l'applicazione Strava di questo server (strava.com/settings/api). Con
# tutte e due, una corsa salvata si può mandare al profilo Strava di chi ha
# collegato il suo atleta; vuota anche una sola, Strava è spento e l'app non
# mostra niente. Il Client ID è un numero e non è un segreto; il Client
# Secret sì: solo qui e in deploy/.env, mai in chat. Restano sull'API: non
# vanno in apps/mobile/.env. Strava rimanda il browser a
# https://SHAPEROUTE_DOMAIN/strava/callback (più sotto).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Email di ritorno (TASK-284, ADR-0244, docs/DEPLOY.md «Email di ritorno») ---
# API: una email a chi non apre l'app da 14 giorni, con Resend. Servono
# tutte e due più SHAPEROUTE_DOMAIN (più sotto, per i link della email);
# vuota anche una sola, nessuna email parte. La chiave di Resend
# (resend.com, dominio getmuw.app verificato) e il segreto dei link
# (`openssl rand -hex 32`, almeno 32 caratteri) li scrive l'utente in
# deploy/.env sul server, mai in chat: cambiare il segreto spegne i link
# delle email già mandate. Restano sull'API: non vanno in apps/mobile/.env.
RESEND_API_KEY=
SHAPEROUTE_EMAIL_SECRET=
# Facoltativi: il mittente (verificato in Resend) e l'ora UTC del giro.
SHAPEROUTE_EMAIL_FROM=
AWAY_EMAIL_AT=

# --- AI (TASK-030, vedi ADR-0012) ---
# Nessuna variabile: il modello gira in Ollama sullo stesso PC, senza chiavi.
# Modello e indirizzo si cambiano con --ai-model e --ai-url all'avvio
# dell'API (docs/API.md). Un provider con chiave la aggiungerebbe qui.

# --- Database degli account (TASK-114, ADR-0115, ADR-0120, docs/DATABASE.md) ---
# API: PostgreSQL con PostGIS. Impostata, l'API applica le migrazioni
# all'avvio e non parte se il database non risponde; vuota, gli account
# rispondono 503 e il resto funziona. Contiene una password: solo qui.
SHAPEROUTE_DATABASE_URL=
# Test dell'API: un server dove creare database usa-e-getta, al posto del
# container che tests/conftest.py avvia con docker. Vuota: docker.
SHAPEROUTE_TEST_DATABASE_URL=
# Server (TASK-122, ADR-0123, docs/DEPLOY.md F.13): la password del database
# di deploy/compose.yaml, che ne fa da sé SHAPEROUTE_DATABASE_URL per l'API.
# Solo lettere e cifre, va dentro un indirizzo: openssl rand -hex 24.
POSTGRES_PASSWORD=
# Server: l'ora UTC della copia notturna del database (HH:MM). Vuota: 02:00.
BACKUP_AT=
# Server (ADR-0123, aggiornamento del 2026-10-02, docs/DEPLOY.md F.13): lo
# Storage Box Hetzner dove vanno le copie e gli eventi delle ricerche, ad
# esempio u123456.your-storagebox.de e u123456. Vuote: le copie restano sul
# server. La chiave SSH sta in /root/.ssh/storagebox, fuori dal repository.
STORAGEBOX_HOST=
STORAGEBOX_USER=

# --- Accesso da fuori casa (TASK-081, ADR-0076, docs/DEPLOY.md) ---
# API: se impostata, ogni richiesta (tranne /health) vuole l'intestazione
# X-API-Key con questo valore, almeno 16 caratteri. Vuota: aperta come oggi.
SHAPEROUTE_API_KEY=
# API: POST al minuto per client (0 = nessun limite). Vuota: 30.
SHAPEROUTE_RATE_LIMIT=
# Server (TASK-144, docs/DEPLOY.md, F.8): il dominio dell'API per Caddy,
# che ne chiede il certificato HTTPS, ad esempio api.tuodominio.it. Serve
# solo con il profilo public di deploy/compose.yaml, e a «Send to Strava»:
# è il dominio a cui Strava rimanda il browser (vuota: l'indirizzo a cui
# l'app ha chiamato l'API).
SHAPEROUTE_DOMAIN=
# Server: le parti in più che docker compose avvia, separate da virgole:
# ai (Ollama), public (Caddy con HTTPS). Vuota: solo l'API.
COMPOSE_PROFILES=
# App (vanno in apps/mobile/.env, letti da Expo all'avvio di npm run mobile):
# indirizzo dell'API al posto di quello trovato da apiUrl.ts, e la stessa
# chiave di SHAPEROUTE_API_KEY.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_KEY=

# --- Registro delle richieste (TASK-090, ADR-0085, docs/API.md) ---
# API: 1 = ogni richiesta di percorso, partenza compresa, è scritta in
# data/requests/requests.jsonl per poterla rifare. Vuota o 0: spento.
SHAPEROUTE_REQUEST_LOG=

# --- Pubblicità fra i post del «Feed» (TASK-235, ADR-0198) ---
# App: gli ID delle unità native di AdMob, una per sistema. Vuoti:
# l'annuncio nativo di prova di Google. Contano solo in una build dell'app,
# non in Expo Go; in una build EAS vanno nelle variabili dell'ambiente.
EXPO_PUBLIC_ADMOB_NATIVE_IOS=
EXPO_PUBLIC_ADMOB_NATIVE_ANDROID=
